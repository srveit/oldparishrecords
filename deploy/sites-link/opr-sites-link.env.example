# /etc/opr-sites-link.env on sites (root:root, mode 600). Read by both systemd units.
# --- sites -> box wake link (opr-notify-forwarder) ---
# Same values as the box's /home/box/agent-data/secrets/opr-webhook.env (routine "OPR approval webhook (server watcher)").
OPR_WEBHOOK_URL=
OPR_WEBHOOK_KEY=
OPR_QUEUE=/opt/oldparishrecords/dashboard/notify_queue.jsonl
OPR_ACTIONS=*
# --- box -> sites segmentation pull (opr-seg-pull) ---
OPR_SEGSYNC_URL=http://100.120.170.46/seg-sync
OPR_SEGSYNC_HOST=grokbot-box.taileabb91.ts.net
# Value of OPR_SEGSYNC_TOKEN in the box's /home/box/agent-data/secrets/opr-segsync.env
OPR_SEGSYNC_TOKEN=
# Must match what approve_server.py / status.py use on sites (check: tr '\0' '\n' < /proc/$(pgrep -f approve_server.py | head -1)/environ | grep OPR_)
OPR_ENTRIES=/workspace/horn-wilmes/entries
OPR_DASH=/opt/oldparishrecords/dashboard
OPR_SYNC_INTERVAL=60
